# Copy to app/.env and fill in what you have. Every key is optional:
# without a key, that part of the product runs on its clearly-labeled fallback.

# Claude (Anthropic): writes the contextual question + reads Rosa's answer into a structured risk signal.
ANTHROPIC_API_KEY=
# CLAUDE_FAST_MODEL=claude-haiku-5-5          # spoken question (latency budget ~2.5 s)
# CLAUDE_REASONING_MODEL=claude-sonnet-5-5    # risk signal from Rosa's answer
# CLAUDE_QUESTION_TIMEOUT_MS=2500
# CLAUDE_ASSESS_TIMEOUT_MS=7000

# Cartesia: slow, clear TTS (Sonic) and push-to-talk STT (Ink-Whisper).
CARTESIA_API_KEY=
# Pick a calm, warm voice from the Cartesia playground and paste its id here.
CARTESIA_VOICE_ID=
# CARTESIA_SPEED=0.85
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_STT_MODEL=ink-whisper
# CARTESIA_VERSION=2026-08-14

# Moss: Rosa's memory (usual spending, stores, scam-script library, past check-ins, family rules).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# MOSS_INDEX=guardiancart-rosa

# PORT=8787
# GUARDIANCART_OFFLINE=1     # force every external service off (rehearse the fallback path)
